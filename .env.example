# Токен бота, полученный у @BotFather в Telegram
BOT_TOKEN=123456789:AAExampleTokenHere

# ID администраторов через запятую (узнать свой ID можно у бота @userinfobot)
ADMIN_IDS=111111111,222222222

# Юзернейм организатора в Telegram для кнопки поддержки (без @)
ORGANIZER_USERNAME=your_telegram_username

# Название турнира

TOURNAMENT_NAME=Турнир по Mortal Kombat 1

# Дата и время турнира в формате ГГГГ-ММ-ДД ЧЧ:ММ
TOURNAMENT_DATETIME=2026-09-15 18:00

# За сколько часов до турнира присылать напоминание с просьбой подтвердить участие
REMINDER_HOURS_BEFORE=24

# Через сколько часов после напоминания слать админу список неподтвердившихся
CONFIRMATION_CHECK_HOURS_AFTER=12

# Максимальное число участников
MAX_PARTICIPANTS=16

# PIN-код для входа в панель админа на сайте
ADMIN_PIN=1234

# Порт и URL для веб-сайта с сеткой
WEB_PORT=8080
WEB_URL=https://www.dara-cyber.kz


